# GitHub credentials
GITHUB_TOKEN=your_github_token_here
GEMINI_API_KEY=your_gemini_api_key_here
REPO_OWNER=your_github_username
REPO_NAME=your_target_repo_name
TARGET_FILE_PATH=app/components/About.jsx
REPO_PATH=../test-target

# ── Database ─────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./evocode.db

# ── Target Repository (V2 format) ──────────────────────────────────────────
GITHUB_REPO=your_username/your_target_repo
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here

# ── LLM Models (V2 — Gemini 3.5 Flash) ──────────────────────────────────
GEMINI_PRIMARY_MODEL=gemini-3.5-flash
GEMINI_LITE_MODEL=gemini-3.5-flash

# ── Autonomy & Threshold Controls (V2) ────────────────────────────────────
UPVOTE_THRESHOLD=1
CONFIDENCE_AUTO_THRESHOLD=70
EXECUTION_MODE=autonomous_pr
SANDBOX_BACKEND=auto

# ── Test Configuration ─────────────────────────────────────────────────────
TEST_TIMEOUT=30
TEST_AUTO_SETUP=true
TEST_SKIP_IF_MISSING=false

# ── Sandbox Configuration ──────────────────────────────────────────────────
SANDBOX_ENABLE_TESTS=true
SANDBOX_CREATE_MINIMAL_TESTS=true
MAX_FIX_RETRIES=3
ENABLE_VISUAL_VERIFIER=false
